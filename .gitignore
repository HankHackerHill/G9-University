# SQLite WAL/shared-memory/journal sidecars hold uncommitted note content; key material never belongs in the tree
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3
binding.key
*.key
# Isolated git worktrees of agent sessions (git-managed; never part of the tree)
/.claude/worktrees/

# Synthetic lab fixtures are .log files by design; docs/curriculum/v2/WEEKS/W01/LABS/fixtures/MANIFEST.md lists the SHA-256 of each, so they must be tracked (a clone without them fails the builder).
!docs/curriculum/v2/WEEKS/*/LABS/fixtures/*.log
!docs/curriculum/v2/WEEKS/*/LABS/fixtures/*/*.log
!docs/curriculum/v2/WEEKS/*/LABS/fixtures/*/*/*.log
!docs/curriculum/v2/WEEKS/*/LABS/fixtures/*/*/*/*.log
!docs/curriculum/v2/WEEKS/*/LABS/fixtures/*/*/*/*/*.log
!docs/curriculum/v2/FIXTURES/*/*.log
!docs/curriculum/v2/FIXTURES/*/*/*.log
