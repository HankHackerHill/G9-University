{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g9.local/fixtures/adversarial-payloads",
  "title": "Adversarial payload fixture (threat-model ST catalogue)",
  "description": "Hostile inputs used by crates/g9-evaluation/src/adversarial.rs. Every payload is inert test data: no working exploit, no secret, no real host.",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixture_kind", "fixture_id", "synthetic", "description", "malicious_notes", "xss_notes", "hostile_actions", "forged_skill_capability"],
  "properties": {
    "fixture_kind": { "const": "ADVERSARIAL_PAYLOADS" },
    "fixture_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "synthetic": { "const": true },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "malicious_notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["st", "title", "body_markdown"],
        "properties": {
          "st": { "type": "string", "pattern": "^ST[0-9]{2}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "body_markdown": { "type": "string", "minLength": 1, "maxLength": 4000 }
        }
      }
    },
    "xss_notes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "hostile_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["st", "action", "resource_kind", "resource_id", "rationale"],
        "properties": {
          "st": { "type": "string", "pattern": "^ST[0-9]{2}$" },
          "action": { "enum": ["EXECUTE", "CONNECT", "LOAD", "DELETE", "EXPORT", "FINALIZE", "APPLY", "APPROVE", "INVOKE"] },
          "resource_kind": { "type": "string", "pattern": "^[A-Z_]{2,40}$" },
          "resource_id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "rationale": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "forged_skill_capability": { "enum": ["SHELL_EXEC", "NETWORK_EGRESS", "FILESYSTEM_WRITE", "POLICY_MODIFY", "MODEL_LOAD"] }
  }
}
