{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g9.local/schemas/curriculum/lesson-sheets",
  "title": "Lesson sheets of a curriculum (v1.0.0)",
  "description": "The lesson sheets the application shows next to the study blocks of a day: one entry per day (the block sections in order, what to watch for, the external resources as text) and one per week (purpose, lab stack, competencies, accelerator). Generated by scripts/build_curriculum.py from docs/curriculum/weeks/; never edited by hand. The Markdown is rendered through the application's sanitizer (no link, no image, no HTML). A sheet is shown only when the objective texts of the day equal the `objectives` recorded here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sheets_schema_version", "curriculum_id", "built_for_version", "note", "weeks", "days"],
  "properties": {
    "sheets_schema_version": { "const": "1.0.0" },
    "curriculum_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "built_for_version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "note": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "weeks": {
      "type": "object",
      "minProperties": 12,
      "maxProperties": 12,
      "additionalProperties": false,
      "patternProperties": {
        "^([1-9]|1[0-2])$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "purpose", "lab_stack", "competencies", "accelerator"],
          "properties": {
            "title": { "type": "string", "minLength": 1, "maxLength": 200 },
            "purpose": { "type": "string", "minLength": 1, "maxLength": 4000 },
            "lab_stack": { "type": "string", "minLength": 1, "maxLength": 4000 },
            "competencies": { "type": "string", "minLength": 1, "maxLength": 4000 },
            "accelerator": { "type": "string", "minLength": 1, "maxLength": 4000 }
          }
        }
      }
    },
    "days": {
      "type": "object",
      "minProperties": 72,
      "maxProperties": 72,
      "additionalProperties": false,
      "patternProperties": {
        "^D(0[1-9]|[1-6][0-9]|7[0-2])$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["week", "title", "objectives", "sections", "watch_for", "extend", "resources"],
          "properties": {
            "week": { "type": "integer", "minimum": 1, "maximum": 12 },
            "title": { "type": "string", "minLength": 1, "maxLength": 200 },
            "objectives": {
              "description": "The objective texts of the day in the manifest this sheet was written for, in order.",
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": { "type": "string", "minLength": 1, "maxLength": 500 }
            },
            "sections": {
              "description": "One section per study block of the day, in the order of the blocks.",
              "type": "array",
              "minItems": 4,
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["key", "name", "minutes", "markdown"],
                "properties": {
                  "key": {
                    "description": "The block name of the manifest (weekday_blocks, saturday_blocks).",
                    "enum": [
                      "recall",
                      "theory",
                      "guided_lab",
                      "independent_lab",
                      "defense_verification",
                      "evidence_reporting",
                      "blind_practical",
                      "remediation",
                      "report",
                      "performance_review"
                    ]
                  },
                  "name": { "type": "string", "minLength": 1, "maxLength": 64 },
                  "minutes": { "type": "integer", "minimum": 1, "maximum": 600 },
                  "markdown": { "type": "string", "minLength": 1, "maxLength": 20000 }
                }
              }
            },
            "watch_for": { "type": ["string", "null"], "minLength": 1, "maxLength": 4000 },
            "extend": { "type": ["string", "null"], "minLength": 1, "maxLength": 4000 },
            "resources": {
              "description": "The external resources of the day as a Markdown list: the address as code, the version, the licence note.",
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            }
          }
        }
      }
    }
  }
}
