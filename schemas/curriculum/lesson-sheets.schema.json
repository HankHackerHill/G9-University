{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g9.local/schemas/curriculum/lesson-sheets",
  "title": "Lesson sheets of a curriculum (v1.0.0 and v1.1.0)",
  "description": "The lesson sheets the application shows next to the study blocks of a day: one entry per day (the block sections in order, what to watch for, the external resources as text) and one per week (purpose, lab stack, competencies, accelerator). Generated by scripts/build_curriculum.py from docs/curriculum/weeks/ (version 1.0.0: 72 days, the Appendix A shape) and by scripts/build_curriculum_v2.py from docs/curriculum/v2/WEEKS/ (version 1.1.0: 60 days, the v2.0 plan); never edited by hand. Version 1.1.0 adds optional per-day fields (header, hand_in, commands, mapping, quiz, recall_queue, hint_ladder, troubleshooting, evidence, reflection); a 1.1.0 file holds all of them except commands (a Friday may have no command table). Answer keys are never part of a sheet: they are a separate file (schemas/curriculum/answer-keys.schema.json). The Markdown is rendered through the application's sanitizer (no link, no image, no HTML). A sheet is shown only when the objective texts of the day equal the `objectives` recorded here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sheets_schema_version", "curriculum_id", "built_for_version", "note", "weeks", "days"],
  "properties": {
    "sheets_schema_version": { "enum": ["1.0.0", "1.1.0"] },
    "curriculum_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "built_for_version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "note": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "weeks": {
      "type": "object",
      "minProperties": 12,
      "maxProperties": 12,
      "additionalProperties": false,
      "patternProperties": {
        "^([1-9]|1[0-2])$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "purpose", "lab_stack", "competencies", "accelerator"],
          "properties": {
            "title": { "type": "string", "minLength": 1, "maxLength": 200 },
            "purpose": { "type": "string", "minLength": 1, "maxLength": 4000 },
            "lab_stack": { "type": "string", "minLength": 1, "maxLength": 4000 },
            "competencies": { "type": "string", "minLength": 1, "maxLength": 4000 },
            "accelerator": { "type": "string", "minLength": 1, "maxLength": 4000 }
          }
        }
      }
    },
    "days": {
      "description": "Version 1.0.0: exactly the 72 days D01 to D72. Version 1.1.0: exactly the 60 days D01 to D60 (see the conditions at the end of this schema).",
      "type": "object",
      "minProperties": 60,
      "maxProperties": 72,
      "additionalProperties": false,
      "patternProperties": {
        "^D(0[1-9]|[1-6][0-9]|7[0-2])$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["week", "title", "objectives", "sections", "watch_for", "extend", "resources"],
          "properties": {
            "week": { "type": "integer", "minimum": 1, "maximum": 12 },
            "title": { "type": "string", "minLength": 1, "maxLength": 200 },
            "objectives": {
              "description": "The objective texts of the day in the manifest this sheet was written for, in order.",
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": { "type": "string", "minLength": 1, "maxLength": 500 }
            },
            "sections": {
              "description": "One section per study block of the day, in the order of the blocks.",
              "type": "array",
              "minItems": 4,
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["key", "name", "minutes", "markdown"],
                "properties": {
                  "key": {
                    "description": "The block name of the manifest (weekday_blocks, saturday_blocks).",
                    "enum": [
                      "recall",
                      "theory",
                      "guided_lab",
                      "independent_lab",
                      "defense_verification",
                      "evidence_reporting",
                      "blind_practical",
                      "remediation",
                      "report",
                      "performance_review"
                    ]
                  },
                  "name": { "type": "string", "minLength": 1, "maxLength": 64 },
                  "minutes": { "type": "integer", "minimum": 1, "maximum": 600 },
                  "markdown": { "type": "string", "minLength": 1, "maxLength": 20000 }
                }
              }
            },
            "watch_for": { "type": ["string", "null"], "minLength": 1, "maxLength": 4000 },
            "extend": { "type": ["string", "null"], "minLength": 1, "maxLength": 4000 },
            "resources": {
              "description": "The external resources of the day as a Markdown list: the address as code, the version, the licence note (version 1.1.0: the title, the provider, the access tier, the verification label and the use in the day).",
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            },
            "header": {
              "description": "Version 1.1.0. The metadata lines of the day guide.",
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "date", "weekday", "lab_authorization", "dependencies", "provider"],
              "properties": {
                "status": { "const": "PROPOSED" },
                "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "The plan's original calendar date (a planning date, not a record of completion)." },
                "weekday": { "enum": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"] },
                "lab_authorization": { "type": "string", "minLength": 1, "maxLength": 2000 },
                "dependencies": { "type": "string", "minLength": 1, "maxLength": 2000 },
                "provider": { "type": "string", "minLength": 1, "maxLength": 320 }
              }
            },
            "hand_in": {
              "description": "Version 1.1.0. The hand-in of the day: the seed text of column D, then its acceptance criteria.",
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "commands": {
              "description": "Version 1.1.0. The table 'Commands proposed for review' as Markdown. Proposed text for the owner's review, never a record of something that ran. Absent when the day has no command (a Friday may have none).",
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            },
            "mapping": {
              "description": "Version 1.1.0. The table offense, detection, remediation, retest as Markdown.",
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            },
            "quiz": {
              "description": "Version 1.1.0. The questions of the day, without keys: five recall and three applied.",
              "type": "object",
              "additionalProperties": false,
              "required": ["recall", "applied"],
              "properties": {
                "recall": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/question" } },
                "applied": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/question" } }
              }
            },
            "recall_queue": {
              "description": "Version 1.1.0. The recall questions of earlier days that fall due on this day (spaced recall at 1, 3, 7 and 14 calendar days, on the plan's calendar). May be empty: block R of the day gives warm-up tasks then.",
              "type": "array",
              "maxItems": 40,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "from_day", "offset_days", "text"],
                "properties": {
                  "id": { "$ref": "#/$defs/question_id" },
                  "from_day": { "type": "string", "pattern": "^D(0[1-9]|[1-5][0-9]|60)$" },
                  "offset_days": { "type": "integer", "minimum": 1, "maximum": 14 },
                  "text": { "type": "string", "minLength": 1, "maxLength": 2000 }
                }
              }
            },
            "hint_ladder": {
              "description": "Version 1.1.0. The first three lines of the hint ladder (no hint, conceptual hint, scoped technical hint). The fourth step is the instructor explanation, in the answer keys.",
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "troubleshooting": { "description": "Version 1.1.0. The seven labelled troubleshooting and rollback lines.", "type": "string", "minLength": 1, "maxLength": 8000 },
            "evidence": { "description": "Version 1.1.0. The evidence, grading and negative-test lines.", "type": "string", "minLength": 1, "maxLength": 8000 },
            "reflection": { "description": "Version 1.1.0. The three reflection prompts.", "type": "string", "minLength": 1, "maxLength": 1000 }
          }
        }
      }
    }
  },
  "$defs": {
    "question_id": {
      "type": "string",
      "pattern": "^W(0[1-9]|1[0-2])D(0[1-9]|[1-5][0-9]|60)-[RA][1-5]$",
      "description": "WnnDNN-R1 to R5 (recall) and WnnDNN-A1 to A3 (applied): the week, the day and the question."
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/question_id" },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "sheets_schema_version": { "const": "1.0.0" } }, "required": ["sheets_schema_version"] },
      "then": {
        "properties": {
          "days": { "minProperties": 72, "maxProperties": 72, "propertyNames": { "pattern": "^D(0[1-9]|[1-6][0-9]|7[0-2])$" } }
        }
      }
    },
    {
      "if": { "properties": { "sheets_schema_version": { "const": "1.1.0" } }, "required": ["sheets_schema_version"] },
      "then": {
        "properties": {
          "days": {
            "minProperties": 60,
            "maxProperties": 60,
            "propertyNames": { "pattern": "^D(0[1-9]|[1-5][0-9]|60)$" },
            "patternProperties": {
              "^D": { "required": ["header", "hand_in", "mapping", "quiz", "recall_queue", "hint_ladder", "troubleshooting", "evidence", "reflection"] }
            }
          }
        }
      }
    }
  ]
}
