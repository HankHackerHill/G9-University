{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g9.local/schemas/curriculum/resource-registry",
  "title": "Weekly resource registry of the v2.0 curriculum (RESOURCES.json)",
  "description": "The labs and references one week of docs/curriculum/v2/WEEKS/Wnn/ may cite: address, provider, access tier, how each entry was verified and when. A day guide cites an entry by its id. Verified by search result only (the authoring session could not open pages), so the strongest verification label is SEARCH_CHECKED. Rules the schema cannot express are enforced by scripts/build_curriculum_v2.py: the file's week equals its folder, every id starts with 'w' and the week number of the file and is unique across all registries, a fallback written as an id names an entry that exists, no hidden or control character in any text.",
  "type": "object",
  "additionalProperties": false,
  "required": ["week", "checked_on", "method", "entries", "plan_fact_checks", "gaps"],
  "properties": {
    "week": { "type": "integer", "minimum": 1, "maximum": 12 },
    "checked_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "The date of the check, YYYY-MM-DD." },
    "method": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "provider",
          "title",
          "kind",
          "access",
          "access_note",
          "verification",
          "evidence",
          "version",
          "topics",
          "suggested_days",
          "block",
          "estimate_minutes",
          "difficulty",
          "fallback",
          "notes"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^w(0[1-9]|1[0-2])-[a-z0-9]+([.-][a-z0-9]+)*$", "maxLength": 80 },
          "url": { "type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 2048 },
          "provider": { "type": "string", "minLength": 1, "maxLength": 100 },
          "title": { "type": "string", "minLength": 1, "maxLength": 300 },
          "kind": { "enum": ["MODULE", "ROOM", "PATH", "LAB", "WARGAME", "MACHINE", "CHALLENGE", "DOCS", "TOOL", "STANDARD"] },
          "access": { "enum": ["FREE", "FREE_ACCOUNT", "PAID", "MIXED", "UNKNOWN"] },
          "access_note": { "type": "string", "maxLength": 2000 },
          "verification": { "enum": ["SEARCH_CHECKED", "ASSUMED", "UNVERIFIED"] },
          "evidence": { "type": "string", "maxLength": 4000 },
          "version": { "type": "string", "minLength": 1, "maxLength": 200 },
          "topics": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
          "suggested_days": { "type": "array", "items": { "type": "string", "pattern": "^D(0[1-9]|[1-5][0-9]|60)$" } },
          "block": { "enum": ["A", "B", "C", "D", "any"] },
          "estimate_minutes": { "type": ["integer", "null"], "minimum": 1, "maximum": 2400 },
          "difficulty": {
            "description": "Null, a text (the provider's own label) or a whole number.",
            "oneOf": [
              { "type": "null" },
              { "type": "string", "minLength": 1, "maxLength": 200 },
              { "type": "integer" }
            ]
          },
          "fallback": { "description": "Null, a registry id or a description of the substitute.", "type": ["string", "null"], "minLength": 1, "maxLength": 1000 },
          "notes": { "type": "string", "maxLength": 4000 }
        }
      }
    },
    "plan_fact_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "result", "evidence"],
        "properties": {
          "claim": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "result": { "enum": ["CONFIRMED", "NOT_CONFIRMED", "CONTRADICTED"] },
          "evidence": { "type": "string", "maxLength": 4000 }
        }
      }
    },
    "gaps": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 2000 } }
  }
}
