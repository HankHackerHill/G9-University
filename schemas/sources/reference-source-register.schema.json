{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g9.local/schemas/sources/reference-source-register",
  "title": "G9 reference source register",
  "description": "Candidate authoritative cybersecurity and AI reference sources for the research-ingestion stage (Stage 12). A proposal: nothing here is approved for ingestion, and every verification level must be backed by evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "register_id", "status", "generated_on", "verification_note", "entries"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "register_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "status": { "enum": ["PROPOSED_UNVERIFIED"] },
    "generated_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "verification_note": { "type": "string", "minLength": 20 },
    "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "publisher", "url", "host", "domain", "kind", "trust_tier", "provides", "access", "license_or_terms", "license_url", "update_cadence", "caveats", "verification", "evidence", "checked_on", "approval_state"],
      "properties": {
        "id": { "type": "string", "pattern": "^SRC-(CYBER|AI)-\\d{2}$" },
        "name": { "type": "string", "minLength": 3 },
        "publisher": { "type": "string", "minLength": 2 },
        "url": { "type": "string", "pattern": "^https://[A-Za-z0-9.-]+(/\\S*)?$" },
        "host": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
        "domain": { "enum": ["cybersecurity", "ai_security", "ai_governance", "ml_models_data"] },
        "kind": { "enum": ["standard", "framework", "vulnerability_database", "knowledge_base", "detection_content", "dataset", "documentation", "model_hub", "incident_database", "tool_reference"] },
        "trust_tier": { "enum": ["PRIMARY_STANDARDS_BODY", "PRIMARY_GOVERNMENT", "PRIMARY_VENDOR_OR_PROJECT", "COMMUNITY_CURATED", "RESEARCH_PREPRINT"] },
        "provides": { "type": "string", "minLength": 3 },
        "access": { "type": "string", "minLength": 3 },
        "license_or_terms": { "type": "string", "minLength": 3 },
        "license_url": { "type": "string", "pattern": "^https://[A-Za-z0-9.-]+(/\\S*)?$" },
        "update_cadence": { "type": "string", "minLength": 3 },
        "caveats": { "type": "string", "minLength": 3 },
        "verification": { "enum": ["VERIFIED", "PARTIAL", "UNVERIFIED"] },
        "evidence": { "type": "string", "minLength": 3 },
        "checked_on": { "type": "string", "minLength": 3 },
        "approval_state": { "enum": ["NOT_APPROVED"] }
      }
    }
  }
}
