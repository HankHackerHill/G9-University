{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g9.local/schemas/ipc/curriculum.set_program_start.response",
  "title": "curriculum.set_program_start response (v1.0)",
  "description": "`result` of CommandOutcome for `curriculum.set_program_start` (payload_schema_version 1.0).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "curriculum_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "description": "Typed identifier `[A-Za-z0-9._:-]{1,128}`."
    },
    "monday": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Civil date `YYYY-MM-DD`."
    },
    "day_start": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
      "description": "Time of day `HH:MM` (24 hours), in the configured zone."
    }
  },
  "required": [
    "curriculum_id",
    "monday",
    "day_start"
  ]
}
