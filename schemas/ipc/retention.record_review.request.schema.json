{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g9.local/schemas/ipc/retention.record_review.request",
  "title": "retention.record_review request (v1.0)",
  "description": "Request payload for `retention.record_review`: the outcome of one review; the baseline schedule advances in the same transaction.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "review_item_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "description": "Typed identifier `[A-Za-z0-9._:-]{1,128}`."
    },
    "outcome": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "FAILURE",
        "SKIPPED"
      ]
    },
    "response_ms": {
      "type": "integer",
      "minimum": 0
    },
    "rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "description": "Typed identifier `[A-Za-z0-9._:-]{1,128}`."
    }
  },
  "required": [
    "review_item_id",
    "outcome"
  ]
}
