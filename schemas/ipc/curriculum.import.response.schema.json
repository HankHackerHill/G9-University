{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g9.local/schemas/ipc/curriculum.import.response",
  "title": "curriculum.import response (v1.0)",
  "description": "`result` of CommandOutcome for `curriculum.import` (payload_schema_version 1.0).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "curriculum_version_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "description": "Typed identifier `[A-Za-z0-9._:-]{1,128}`."
    },
    "checksum_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Hex SHA-256."
    },
    "provenance": {
      "type": "string",
      "enum": [
        "PROPOSED_SEED",
        "RECONCILED_CANDIDATE",
        "APPROVED_CANONICAL"
      ]
    },
    "weeks": {
      "type": "integer",
      "minimum": 0
    },
    "days": {
      "type": "integer",
      "minimum": 0
    },
    "objectives": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "curriculum_version_id",
    "checksum_sha256",
    "provenance",
    "weeks",
    "days",
    "objectives"
  ]
}
