{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g9.local/schemas/ipc/notes.get.request",
  "title": "notes.get request (v1.0)",
  "description": "Request payload for `notes.get`: one note with its body.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "note_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "description": "Typed identifier `[A-Za-z0-9._:-]{1,128}`."
    }
  },
  "required": [
    "note_id"
  ]
}
