{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g9.local/schemas/ipc/session.plan_day.request",
  "title": "session.plan_day request (v1.0)",
  "description": "Request payload for `session.plan_day`: plan the blocks of the program day that falls on `date`.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Civil date `YYYY-MM-DD`."
    }
  },
  "required": [
    "date"
  ]
}
