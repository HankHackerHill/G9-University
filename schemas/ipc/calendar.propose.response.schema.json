                "maxLength": 128,
                "pattern": "^[A-Za-z0-9._:-]+$",
                "description": "Typed identifier `[A-Za-z0-9._:-]{1,128}`."
              },
              "block": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "session_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9._:-]+$",
                "description": "Typed identifier `[A-Za-z0-9._:-]{1,128}`."
              },
              "adjusted": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "GAP",
                  "OVERLAP",
                  null
                ],
                "description": "DST adjustment applied when resolving the civil time (ARCHITECTURE §7)."
              },
              "provenance": {
                "type": "string",
                "enum": [
                  "OPERATOR",
                  "SYSTEM_DETERMINISTIC",
                  "APPROVED_REFERENCE",
                  "IMPORTED_DOCUMENT",
                  "SKILL_PACKAGE",
                  "MODEL_OUTPUT",
                  "UNKNOWN"
