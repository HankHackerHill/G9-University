{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g9.local/schemas/ipc/calendar.propose.response",
  "title": "calendar.propose response (v1.0)",
  "description": "`result` of CommandOutcome for `calendar.propose` (payload_schema_version 1.0).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "proposal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "description": "Typed identifier `[A-Za-z0-9._:-]{1,128}`."
    },
    "feasible": {
      "type": "boolean"
    },
    "violated_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "event_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "description": "Typed identifier `[A-Za-z0-9._:-]{1,128}`."
          }
        },
        "required": [
          "code",
          "message",
          "event_id"
        ]
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "CREATE",
              "MOVE",
              "DELETE"
            ]
          },
          "event": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "event_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9._:-]+$",
                "description": "Typed identifier `[A-Za-z0-9._:-]{1,128}`."
              },
              "title": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "STUDY_BLOCK",
                  "ASSESSMENT",
                  "REVIEW",
                  "APPOINTMENT",
                  "PROTECTED_REST",
                  "BUSINESS"
                ]
              },
              "start": {
                "type": "integer",
                "minimum": 0,
                "description": "UTC instant, integer epoch milliseconds."
              },
              "end": {
                "type": "integer",
                "minimum": 0,
                "description": "UTC instant, integer epoch milliseconds."
              },
              "all_day": {
                "type": "boolean"
              },
              "immutable": {
                "type": "boolean"
              },
              "day_id": {
