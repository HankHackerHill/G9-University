{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g9.local/schemas/ipc/audit.recent.response",
  "title": "audit.recent response (v1.0)",
  "description": "`result` of CommandOutcome for `audit.recent` (payload_schema_version 1.0).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "description": "Typed identifier `[A-Za-z0-9._:-]{1,128}`."
          },
          "prev_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Hex SHA-256."
          },
          "row_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Hex SHA-256."
          },
          "occurred_at": {
            "type": "integer",
            "minimum": 0,
            "description": "UTC instant, integer epoch milliseconds."
          },
          "actor_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "description": "Typed identifier `[A-Za-z0-9._:-]{1,128}`."
          },
          "actor_kind": {
            "type": "string",
            "enum": [
              "OPERATOR",
              "SYSTEM",
              "SKILL",
              "MODEL"
            ]
          },
          "operation": {
            "type": "string"
          },
          "resource_kind": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "CURRICULUM",
              "CURRICULUM_VERSION",
              "CALENDAR_EVENT",
              "SCHEDULE_PROPOSAL",
              "STUDY_SESSION",
              "TIME_INTERVAL",
              "NOTE",
              "ATTACHMENT",
              "EVIDENCE_ITEM",
              "ASSESSMENT_DEFINITION",
              "ATTEMPT",
              "GRADE_DECISION",
              "COMPETENCY",
              "OBSERVATION",
              "LEARNER_HYPOTHESIS",
              "REVIEW_ITEM",
              "INTERVENTION",
              "EXPERIMENT",
              "GOAL",
              "PROJECT",
              "MILESTONE",
              "DECISION",
              "RESEARCH_SOURCE",
              "KNOWLEDGE_DOCUMENT",
              "MODEL",
              "SKILL",
              "SKILL_INVOCATION",
              "APPROVAL",
              "BACKUP",
              "POLICY",
              "EXPORT",
              "FILESYSTEM_PATH",
              "NETWORK_HOST",
              "PROCESS",
              "APP_SETTING",
              "AUDIT_METADATA",
              null
            ]
          },
          "resource_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "description": "Typed identifier `[A-Za-z0-9._:-]{1,128}`."
          },
          "decision": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "OK",
              "ERROR"
            ]
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "description": "Typed identifier `[A-Za-z0-9._:-]{1,128}`."
          },
          "trace_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "description": "Typed identifier `[A-Za-z0-9._:-]{1,128}`."
          },
          "details_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Hex SHA-256."
          }
        },
        "required": [
          "id",
          "prev_hash",
          "row_hash",
          "occurred_at",
          "actor_id",
          "actor_kind",
          "operation",
          "resource_kind",
          "resource_id",
          "decision",
          "outcome",
          "request_id",
          "trace_id",
          "details_sha256"
