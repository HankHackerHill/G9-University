{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g9.local/schemas/ipc/evidence.attach_file.request",
  "title": "evidence.attach_file request (v1.0)",
  "description": "Request payload for `evidence.attach_file`: attach a file the operator picked; the bytes travel base64 (at most 16 MiB decoded). The attachment takes its note's domain and classification; without a note it is LEARNING data with `classification` (default INTERNAL).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "note_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "description": "Typed identifier `[A-Za-z0-9._:-]{1,128}`."
    },
    "filename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "media_type": {
      "type": "string",
      "enum": [
        "text/markdown",
        "text/plain",
        "application/pdf",
        "image/png",
        "image/jpeg",
        "application/json",
        "text/csv"
      ]
    },
    "content_base64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 22369624
    },
    "classification": {
      "type": "string",
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "PRIVATE",
        "SECRET"
      ]
    }
  },
  "required": [
    "filename",
    "media_type",
    "content_base64"
  ]
}
