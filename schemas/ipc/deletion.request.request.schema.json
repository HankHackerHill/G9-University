{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g9.local/schemas/ipc/deletion.request.request",
  "title": "deletion.request request (v1.0)",
  "description": "Request payload for `deletion.request`. Validated by g9-app at pipeline step 1 against payload_schema_version 1.0. Protected: the backend answers APPROVAL_REQUIRED until a bound approval_id is supplied in command-meta.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "CURRICULUM",
            "CURRICULUM_VERSION",
            "CALENDAR_EVENT",
            "SCHEDULE_PROPOSAL",
            "STUDY_SESSION",
            "TIME_INTERVAL",
            "NOTE",
            "ATTACHMENT",
            "EVIDENCE_ITEM",
            "ASSESSMENT_DEFINITION",
            "ATTEMPT",
            "GRADE_DECISION",
            "COMPETENCY",
            "OBSERVATION",
            "LEARNER_HYPOTHESIS",
            "REVIEW_ITEM",
            "INTERVENTION",
            "EXPERIMENT",
            "GOAL",
            "PROJECT",
            "MILESTONE",
            "DECISION",
            "RESEARCH_SOURCE",
            "KNOWLEDGE_DOCUMENT",
            "MODEL",
            "SKILL",
            "SKILL_INVOCATION",
            "APPROVAL",
            "BACKUP",
            "POLICY",
            "EXPORT",
            "FILESYSTEM_PATH",
            "NETWORK_HOST",
            "PROCESS",
            "APP_SETTING",
            "AUDIT_METADATA"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "description": "Typed identifier `[A-Za-z0-9._:-]{1,128}`."
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "description": "Reference to a protected resource (ResourceRef)."
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Why the record is erased. Kept with the request on this machine; never exported (ADR-0017)."
    }
  },
  "required": [
    "resource",
    "reason"
  ]
}
