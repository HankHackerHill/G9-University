{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g9.local/skills/g9-competency-evidence/output",
  "title": "g9-competency-evidence result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state",
    "per_dimension",
    "evidence_refs"
  ],
  "properties": {
    "state": {
      "type": "string",
      "description": "Derived summary state"
    },
    "per_dimension": {
      "type": "object",
      "description": "Per-dimension estimates",
      "additionalProperties": true
    },
    "evidence_refs": {
      "type": "array",
      "description": "Observation ids",
      "items": {}
    },
    "contradictions": {
      "type": "array",
      "description": "Contradictions",
      "items": {}
    },
    "next_evidence": {
      "type": "string",
      "description": "Proposed next evidence"
    }
  }
}
