{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g9.local/skills/g9-session-director/input",
  "title": "g9-session-director input_payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "day_id",
    "mode"
  ],
  "properties": {
    "day_id": {
      "type": "string",
      "description": "Training day id"
    },
    "mode": {
      "type": "string",
      "description": "STUDY or LAB"
    },
    "include_due_reviews": {
      "type": "boolean",
      "description": "Include due reviews"
    },
    "include_open_interventions": {
      "type": "boolean",
      "description": "Include open interventions"
    }
  }
}
